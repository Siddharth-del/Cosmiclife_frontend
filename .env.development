# Loaded by `npm run dev` (storefront at http://localhost:5173). Public values only.
# The dev server forwards every /api/... call to this backend, so the browser never makes a
# cross-origin request. Use your local Spring Boot server, or your Render backend URL.
VITE_API_PROXY_TARGET=http://localhost:8080
# Leave empty: the browser calls this site's own /api (forwarded above).
VITE_API_BASE_URL=
# IN serves cosmiclife.in in rupees; INTL serves cosmiclife.net in dollars.
VITE_MARKET=IN
