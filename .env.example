# Public configuration only. Never put secrets here: every VITE_ variable is visible in the browser.
# Razorpay's public key id comes from the backend at checkout; the secret stays on the server.

# Browser API base URL. Empty = this site's own /api (recommended; works without backend CORS).
VITE_API_BASE_URL=

# Where `npm run dev` / `npm run preview` forward /api (not used by the built site on Render).
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional: your email provider's public form endpoint for the newsletter (receives {"email": "..."}).
# Empty = the form says sign-ups aren't open yet.
VITE_NEWSLETTER_URL=
# IN serves cosmiclife.in in rupees; INTL serves cosmiclife.net in dollars.
VITE_MARKET=IN
